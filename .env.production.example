# Copy to a private production env file and fill in values with the deployment owner.
# Never use these placeholders as production credentials.

# Public HTTPS host preserved by the trusted TLS edge (hostname or IPv4, no scheme/path).
PROD_PUBLIC_HOST=aqours.example.test
PROD_WEB_PORT=8080

# CI/deployment may replace the local build tags with immutable registry references.
PROD_API_IMAGE=aqours-production-api:local
PROD_WEB_IMAGE=aqours-production-web:local
PROD_MIGRATION_IMAGE=aqours-production-migration:local

# Non-overlapping private bridge subnets. The TLS edge must forward only through proxy.
PROD_PROXY_CIDR=172.30.0.0/24
PROD_DATABASE_CIDR=172.31.0.0/24

# PostgreSQL bootstrap identity. Keep the API and migration connections on separate roles.
PROD_POSTGRES_DB=aqours
PROD_POSTGRES_USER=aqours_bootstrap
PROD_POSTGRES_PASSWORD=

# Runtime account must have only the privileges needed by the running application.
PROD_API_CONNECTION_STRING=
# Migration account is used only for the explicit migration profile/command.
PROD_MIGRATION_CONNECTION_STRING=

# Authentication configuration. Use a strong signing key generated by the operator.
PROD_JWT_ISSUER=
PROD_JWT_AUDIENCE=
PROD_JWT_SIGNING_KEY=

# The email is checked on every API startup; other seed fields are needed only if absent.
PROD_SEED_ADMIN_EMAIL=
PROD_SEED_ADMIN_FIRST_NAME=
PROD_SEED_ADMIN_MIDDLE_NAME=
PROD_SEED_ADMIN_LAST_NAME=
PROD_SEED_ADMIN_PASSWORD=

# Public Geoapify browser key, embedded in the static web bundle at image build time.
PROD_VITE_GEOAPIFY_API_KEY=
