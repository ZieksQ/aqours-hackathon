# Local Docker development configuration. Copy to .env and replace every placeholder.
# Keep the database password in sync with the Password field in DOCKER_API_CONNECTION_STRING.
POSTGRES_DB=aqours
POSTGRES_USER=aqours
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

# Used by the API container. Host must be db and port must be 5432 inside Compose.
DOCKER_API_CONNECTION_STRING=Host=db;Port=5432;Database=aqours;Username=aqours;Password=replace-with-a-local-password

# API startup requires JWT settings and an email. The other seed values are required
# only when the initial administrator does not already exist.
JWT_ISSUER=Aqours.Local
JWT_AUDIENCE=Aqours.WebAndMobile
JWT_SIGNING_KEY=
SEED_ADMIN_EMAIL=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_MIDDLE_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_PASSWORD=

# Browser-visible map keys. Use dedicated public keys and restrict them by origin.
VITE_GEOAPIFY_API_KEY=
EXPO_PUBLIC_GEOAPIFY_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Set LAN_IP and API_BIND_ADDRESS when using the optional mobile profile on a phone.
LAN_IP=
API_BIND_ADDRESS=127.0.0.1

# Linux container file ownership defaults. Set VITE_USE_POLLING=true only if needed.
LOCAL_UID=1000
LOCAL_GID=1000
VITE_USE_POLLING=false
