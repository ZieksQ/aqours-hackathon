# API origin only; do not include /api. Use your computer's LAN address on a phone.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5251

# Public client tile key from your Geoapify project. Never put server credentials here.
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Optional Expo project ID required to register for remote push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=
